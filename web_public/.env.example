# Скопируй в .env и заполни реальными значениями
# НЕ коммитить .env в git!

# ── База данных ───────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/coi_public

# ── Flask ─────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-random-secret-string
FLASK_ENV=development

# ── Google OAuth ──────────────────────────────────────────────────
# Получить на: console.cloud.google.com → Credentials → OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── Steam OpenID ──────────────────────────────────────────────────
# Получить на: steamcommunity.com/dev/apikey
STEAM_API_KEY=your-steam-api-key

# ── Email (SMTP) для авторизации ─────────────────────────────────
# Если SMTP_HOST не задан — код выводится в консоль (только dev-режим!)
#
# Gmail App Password (бесплатно, 500 писем/день):
#   1. Включить 2FA: myaccount.google.com → Безопасность → Двухэтапная аутентификация
#   2. Создать пароль: myaccount.google.com → Безопасность → Пароли приложений
#      → Название: "CoI Planner" → Создать
#   3. Скопировать 16 символов (без пробелов) в SMTP_PASS
#   Проверить: flask send-test-email your@email.com
#
# SMTP_FROM до покупки домена: оставить пустым (подставится SMTP_USER автоматически)
# SMTP_FROM после покупки домена: noreply@yourdomain.com (добавить SPF в DNS)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=abcdefghijklmnop
SMTP_FROM=

# ── Лимиты ───────────────────────────────────────────────────────
MAX_COMPLEXES_PER_USER=0           # 0 = без лимита; >0 — максимум комплексов на аккаунт
# RATELIMIT_STORAGE_URI=redis://localhost:6379/0  # для продакшена; по умолчанию in-memory

# ── Обратный прокси (продакшн) ───────────────────────────────────
# Включить ТОЛЬКО когда приложение работает за Nginx/reverse-proxy.
# Тогда Flask доверяет X-Forwarded-Proto/Host (нужно для https в OAuth-редиректах и og:url).
# Локально (python app.py) — оставить выключенным.
# TRUST_PROXY=1

# ── URL сайта (для OG-тегов, OAuth redirect и sitemap.xml) ───────
# До покупки домена: оставить пустым (берётся из request.host_url автоматически)
# После покупки домена раскомментировать:
# SITE_URL=https://yourdomain.com
# ВАЖНО в проде: без SITE_URL (или без TRUST_PROXY=1) в sitemap.xml попадут
# http-ссылки на внутренний хост — поисковики такой sitemap проигнорируют.

# ── Мониторинг и админка ──────────────────────────────────────────
# Почты через запятую. Владельцы этих аккаунтов видят /admin/stats;
# им же уходят письма мониторинга. Пусто — админки нет вообще, а письма
# отправлять некому. Почта должна совпадать с той, под которой вы входите
# на сайт (Google или email-код); у входа через Steam почты нет.
# ADMIN_EMAILS=you@example.com
#
# Пороги проверок — менять только если типовые не подходят:
# MONITOR_DISK_MIN_RATIO=0.15        # тревога, если свободно меньше 15% диска
# MONITOR_DB_GROWTH_RATIO=0.25       # тревога, если БД выросла больше чем на 25% за сутки
# MONITOR_TRAFFIC_DROP_RATIO=0.3     # тревога, если трафик упал ниже 30% от недельной медианы
# MONITOR_TRAFFIC_MIN_BASELINE=10    # проверка трафика включается от этой медианы

# ── Продакшн SECRET_KEY ───────────────────────────────────────────
# Сгенерировать: python -c "import secrets; print(secrets.token_hex(32))"
